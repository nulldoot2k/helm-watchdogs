{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "vault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {"type": "string", "minLength": 1},
        "service": {"type": "string", "minLength": 1}
      },
      "required": ["namespace", "service"]
    },
    "watchdog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {"type": "integer", "minimum": 2},
        "intervalSeconds": {"type": "integer", "minimum": 1},
        "autoUnseal": {"type": "boolean"},
        "allowPodDelete": {"type": "boolean"},
        "maxRemediationsPerHour": {"type": "integer", "minimum": 0},
        "secretName": {"type": "string"}
      },
      "required": ["replicas", "intervalSeconds", "autoUnseal", "allowPodDelete", "maxRemediationsPerHour", "secretName"]
    }
  },
  "required": ["image", "vault", "watchdog"]
}
