{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "vault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {"type": "string", "minLength": 1},
        "service": {"type": "string", "minLength": 1}
      },
      "required": ["namespace", "service"]
    },
    "watchdog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {"type": "integer", "minimum": 2},
        "intervalSeconds": {"type": "integer", "minimum": 1},
        "autoUnseal": {"type": "boolean"},
        "allowPodDelete": {"type": "boolean"},
        "maxRemediationsPerHour": {"type": "integer", "minimum": 0},
        "secretName": {"type": "string"}
      },
      "required": ["replicas", "intervalSeconds", "autoUnseal", "allowPodDelete", "maxRemediationsPerHour", "secretName"]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      },
      "required": ["enabled", "port"]
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "secretName": {"type": "string"},
        "tokenKey": {"type": "string", "minLength": 1}
      },
      "required": ["enabled", "port", "secretName", "tokenKey"]
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}
      },
      "required": ["enabled"]
    },
    "keyService": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          },
          "required": ["repository", "tag", "pullPolicy"]
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "raftPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "replicas": {"type": "integer", "minimum": 3},
        "bootstrap": {"type": "boolean"},
        "secretName": {"type": "string"},
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "secretName": {"type": "string"},
            "caKey": {"type": "string", "minLength": 1},
            "certKey": {"type": "string", "minLength": 1},
            "keyKey": {"type": "string", "minLength": 1}
          },
          "required": ["enabled", "secretName", "caKey", "certKey", "keyKey"]
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"size": {"type": "string", "minLength": 1}},
          "required": ["size"]
        }
      },
      "required": ["enabled", "image", "port", "raftPort", "replicas", "bootstrap", "secretName", "tls", "storage"]
    }
  },
  "required": ["image", "vault", "watchdog", "metrics", "api", "ui", "keyService"]
}
